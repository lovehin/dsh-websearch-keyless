{
  "name": "dsh-websearch-keyless",
  "version": "0.1.0",
  "description": "Keyless web search for DeepSeek Harness: Tavily, TinyFish and Exa with no API key, mirroring OpenCode's web search backends.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "cordis-plugin",
    "web-search",
    "tavily",
    "tinyfish",
    "exa",
    "opencode"
  ],
  "license": "MIT",
  "author": "lovehin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovehin/dsh-websearch-keyless.git"
  },
  "homepage": "https://github.com/lovehin/dsh-websearch-keyless#readme",
  "bugs": {
    "url": "https://github.com/lovehin/dsh-websearch-keyless/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:live": "node test/live.js --backends"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
